# Supabase (project: research-catalyst, ap-south-1)
SUPABASE_URL=https://odrskjcvrjzcscqgjber.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Dashboard > Project Settings > API (server only, never commit)
VITE_SUPABASE_URL=https://odrskjcvrjzcscqgjber.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Razorpay (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # set when creating the webhook

# Public site URL used for callbacks
PUBLIC_SITE_URL=

# AI screening (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# One-time administrator bootstrap (server-only). Set a random >=32 char value, claim the first super_admin once via
# claimBootstrapAdmin, then REMOVE it. ADMIN_BOOTSTRAP_EMAIL optionally restricts which account may claim.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=

# Optional extra AI screening providers / budget guards (ported from the main branch). Unset = provider skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_COST_PER_PAPER_USD=0.5
AI_MAX_DAILY_COST_USD=100

# ORCID sign-in (server-only; set these in the HOSTING environment, e.g. Vercel, not only in Supabase)
# Register the redirect URI  <PUBLIC_SITE_URL>/orcid/callback  in your ORCID developer tools.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_STATE_SECRET=   # any long random string you make up
ORCID_ENV=production  # leave unset or "sandbox" to use sandbox.orcid.org
